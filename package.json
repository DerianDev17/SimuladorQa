{
  "name": "coonecta-atm-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Estación desktop de QA para simulación ATM Coonecta",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.20.0 <23 || >=24"
  },
  "scripts": {
    "dev": "node tooling/dev.mjs",
    "build": "node tooling/build.mjs",
    "start": "electron dist/main.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "prepare:electron": "node tooling/prepare-electron.mjs",
    "test:e2e": "npm run prepare:electron && npm run build && playwright test",
    "check:security": "node tooling/check-security.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:security && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.6.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
